# Loaded automatically by Bun — no dotenv, no imports.

# APS (Autodesk Platform Services) app credentials — server-side only, never sent to the client.
APS_CLIENT_ID=
APS_CLIENT_SECRET=

# OSS bucket holding the demo models. Expected to be pre-translated to SVF2.
APS_BUCKET_KEY=

PORT=8080

# Required. Origin screenshot URLs are built from — must be reachable by the agent host,
# so behind a tunnel this is the tunnel's URL, e.g. https://your-name.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:8080
