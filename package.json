{
  "name": "ai-aided-design-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebMCP demo on top of the APS Viewer — exposes viewer capabilities to an AI agent as browser tools.",
  "scripts": {
    "dev": "bun --hot index.ts",
    "start": "NODE_ENV=production bun index.ts",
    "build": "bun build ./client/index.html --outdir dist/client --minify",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^5.7.3"
  }
}
